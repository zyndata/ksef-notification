# Copy to .env and fill in for your machine. .env is git-ignored — never commit it.

# Absolute path to your test Home Assistant configuration directory
# (the folder containing configuration.yaml). Used by `python scripts/install.py`.
# Linux example:   /home/you/ha-config
# Windows example: C:\Users\you\ha-config
HA_CONFIG_DIR=

# Optional: a KSeF account for manual checks against a live KSeF environment. The test
# suite never reads these and never touches the network. Use the TEST environment
# (fictional data only); never put a production token here.
# KSEF_ENV is one of: test, demo, prod.
KSEF_ENV=test
KSEF_NIP=
KSEF_TOKEN=
